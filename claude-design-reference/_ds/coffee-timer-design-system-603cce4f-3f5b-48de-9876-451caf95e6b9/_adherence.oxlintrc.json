{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/beans/**",
              "components/core/**",
              "components/forms/**",
              "components/timer/**",
              "ui_kits/coffee-timer/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Zen Kaku Gothic New))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Zen Kaku Gothic New."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|roaster|meta|overall|favorite|flavors|onEdit|onDelete|onToggleFavorite|key|ref|className|style|children)$/]",
        "message": "<BeanCard> doesn't accept that prop. Declared props: name, roaster, meta, overall, favorite, flavors, onEdit, onDelete, onToggleFavorite."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|well|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, action, well, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Collapsible'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|defaultOpen|children|key|ref|className|style|children)$/]",
        "message": "<Collapsible> doesn't accept that prop. Declared props: label, defaultOpen, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ControlButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|primary|active|label|onClick|size|key|ref|className|style|children)$/]",
        "message": "<ControlButton> doesn't accept that prop. Declared props: icon, primary, active, label, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ControlButton'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:play|pause|stop|music|plus)$/]",
        "message": "<ControlButton> icon must be one of 'play' | 'pause' | 'stop' | 'music' | 'plus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|multiline|rows|placeholder|value|onChange|unit|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, type, multiline, rows, placeholder, value, onChange, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressSteps'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|percent|key|ref|className|style|children)$/]",
        "message": "<ProgressSteps> doesn't accept that prop. Declared props: steps, current, percent."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadarChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|labels|size|max|key|ref|className|style|children)$/]",
        "message": "<RadarChart> doesn't accept that prop. Declared props: values, labels, size, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingScale'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|key|ref|className|style|children)$/]",
        "message": "<RatingScale> doesn't accept that prop. Declared props: label, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|onChange|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:wood|sage|bluegray|terracotta|empty)$/]",
        "message": "<Tag> tone must be one of 'wood' | 'sage' | 'bluegray' | 'terracotta' | 'empty'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|step|status|running|compact|key|ref|className|style|children)$/]",
        "message": "<TimerDisplay> doesn't accept that prop. Declared props: time, step, status, running, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|showState|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, checked, onChange, showState."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
